NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firearena?schema=public
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
BASE_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Free Fire player info API key — obtain from the API provider
FREEFIRE_API_KEY=your-freefire-api-key-here

# Automated UPI Deposit Configuration
# Note: Set your actual registered UPI ID (VPA) in your local .env and in the production environment (Render) separately.
MERCHANT_UPI_ID=your-merchant-upi-id@bank
UPI_MERCHANT_NAME=NeoBattle
WEBHOOK_SECRET=your-sms-webhook-secret-here
